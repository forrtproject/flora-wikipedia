{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FLoRA English edit suggestion draft, brief v6 (private review material)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "brief_version",
    "card_id",
    "claim_sites",
    "article_scope",
    "citation_function",
    "article_use",
    "replications_assessed",
    "specific_study_match",
    "existing_acknowledgement",
    "evidence_used",
    "assessment",
    "proposed_action",
    "queue_recommendation",
    "rationale",
    "draft",
    "content_points",
    "alternatives",
    "uncertainties",
    "required_checks",
    "flags",
    "verifications",
    "edit_strength",
    "no_change_basis"
  ],
  "properties": {
    "brief_version": {
      "const": "v6"
    },
    "card_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{20}$"
    },
    "claim_sites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "occurrence",
          "section",
          "visible_claim_quote",
          "is_visible_claim",
          "note"
        ],
        "properties": {
          "occurrence": {
            "type": "integer",
            "minimum": 1
          },
          "section": {
            "type": "string"
          },
          "visible_claim_quote": {
            "type": "string"
          },
          "is_visible_claim": {
            "type": "boolean"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "article_scope": {
      "enum": [
        "paper",
        "effect",
        "effect_section",
        "broad_topic",
        "biography_history",
        "incidental",
        "list_or_bibliography"
      ]
    },
    "citation_function": {
      "enum": [
        "current_empirical_support",
        "historical_attribution",
        "example",
        "bibliography_listing",
        "unclear"
      ]
    },
    "article_use": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "states_finding",
        "relies_as_evidence",
        "note"
      ],
      "properties": {
        "states_finding": {
          "enum": [
            "as_fact",
            "attributed",
            "reported_as_disputed",
            "no"
          ],
          "description": "Whether the Wikipedia article itself states the paper's result: in its own voice, attributed ('X found that'), only to say it was retracted, refuted, disputed or mixed, or not at all (named, listed, described, prize citation or title)."
        },
        "relies_as_evidence": {
          "type": "boolean",
          "description": "True if a statement in the Wikipedia article depends on the paper's result being right."
        },
        "note": {
          "type": "string"
        }
      }
    },
    "replications_assessed": {
      "type": "array",
      "minItems": 1,
      "description": "One entry per FLoRA-linked replication in the packet, in packet order.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "doi",
          "method",
          "tested_result",
          "bears_on_article_claim",
          "result_vs_article_claim",
          "already_on_page",
          "page_quote",
          "report_accurate",
          "note"
        ],
        "properties": {
          "doi": {
            "type": "string"
          },
          "method": {
            "enum": [
              "replication",
              "reanalysis",
              "other"
            ]
          },
          "tested_result": {
            "enum": [
              "cited_result",
              "other_result_same_paper",
              "different_topic",
              "unclear"
            ]
          },
          "bears_on_article_claim": {
            "enum": [
              "direct",
              "indirect",
              "none",
              "unclear"
            ]
          },
          "result_vs_article_claim": {
            "enum": [
              "confirms",
              "qualifies",
              "fails",
              "inconclusive",
              "not_determinable"
            ],
            "description": "The model's reading of the papers against the result as the Wikipedia article states or relies on it; never the FLoRA outcome code."
          },
          "already_on_page": {
            "enum": [
              "cited",
              "reported_in_prose",
              "reported_via_other_source",
              "no"
            ]
          },
          "page_quote": {
            "type": "string",
            "description": "Verbatim sentence of the Wikipedia article that reports the replication; empty when already_on_page is no."
          },
          "report_accurate": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Null exactly when already_on_page is no."
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "specific_study_match": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "note"
      ],
      "properties": {
        "status": {
          "enum": [
            "matched",
            "partial",
            "mismatch",
            "uncertain",
            "not_applicable"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "description": "Card-level summary of replications_assessed (shown on the card)."
    },
    "existing_acknowledgement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "note"
      ],
      "properties": {
        "status": {
          "enum": [
            "yes",
            "partial",
            "no",
            "unclear"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "description": "Card-level summary of already_on_page across replications (shown on the card)."
    },
    "evidence_used": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "doi",
          "role",
          "evidence_level",
          "excerpt",
          "what_it_supports"
        ],
        "properties": {
          "doi": {
            "type": "string"
          },
          "role": {
            "enum": [
              "original",
              "replication",
              "secondary_lead",
              "other_packet_source"
            ]
          },
          "evidence_level": {
            "enum": [
              "full_text",
              "abstract",
              "metadata_only"
            ]
          },
          "excerpt": {
            "type": "string"
          },
          "what_it_supports": {
            "type": "string"
          }
        }
      }
    },
    "assessment": {
      "type": "string",
      "minLength": 40
    },
    "proposed_action": {
      "enum": [
        "no_change",
        "contextualise",
        "narrow_claim",
        "replace_source",
        "upgrade_source",
        "remove_unsupported_claim",
        "remove_citation",
        "talk_page",
        "defer"
      ]
    },
    "queue_recommendation": {
      "enum": [
        "retain",
        "drop",
        "defer"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 20
    },
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "location",
        "operation",
        "target_text",
        "wording",
        "citations",
        "withheld_reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "provided",
            "not_applicable"
          ]
        },
        "location": {
          "type": "string"
        },
        "operation": {
          "enum": [
            "insert_after",
            "replace",
            "modify",
            "remove",
            "none"
          ]
        },
        "target_text": {
          "type": "string"
        },
        "wording": {
          "type": "string"
        },
        "citations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "withheld_reason": {
          "type": "string"
        }
      }
    },
    "content_points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "point",
          "source",
          "evidence_level"
        ],
        "properties": {
          "point": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "evidence_level": {
            "enum": [
              "full_text",
              "abstract",
              "metadata_only"
            ]
          }
        }
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "action",
          "when",
          "target_article"
        ],
        "properties": {
          "type": {
            "enum": [
              "reference_slip",
              "wording",
              "optional_reference",
              "belongs_elsewhere",
              "other"
            ]
          },
          "action": {
            "type": "string"
          },
          "when": {
            "type": "string"
          },
          "target_article": {
            "type": "string",
            "description": "Title of the other Wikipedia article for belongs_elsewhere; empty otherwise."
          }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_checks": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "string"
      },
      "description": "Only editorial judgement calls left to the human (for example how much weight to give a finding). Never verification or reading tasks."
    },
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blp",
        "medrs",
        "other"
      ],
      "properties": {
        "blp": {
          "type": "boolean"
        },
        "medrs": {
          "type": "boolean"
        },
        "other": {
          "type": "string"
        }
      }
    },
    "verifications": {
      "type": "array",
      "description": "Every factual claim the suggestion relies on, or that the article makes about the study, checked by the model itself against the source text.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "source",
          "result",
          "quote",
          "evidence_level"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 10
          },
          "source": {
            "type": "string"
          },
          "result": {
            "enum": [
              "confirmed",
              "contradicted",
              "not_in_source",
              "source_unavailable"
            ]
          },
          "quote": {
            "type": "string"
          },
          "evidence_level": {
            "enum": [
              "full_text",
              "abstract",
              "metadata_only"
            ]
          }
        }
      }
    },
    "edit_strength": {
      "enum": [
        "fix",
        "recommended_addition",
        "optional_addition",
        "none"
      ],
      "description": "fix = the article states something the source contradicts or does not support; recommended_addition = a failed or materially qualifying direct replication (or reanalysis) of a finding the article relies on is missing; optional_addition = the article is accurate and the addition only confirms or enriches; none = nothing to do."
    },
    "no_change_basis": {
      "enum": [
        "already_reported",
        "listed_only",
        "named_without_finding",
        "tests_other_claim",
        "scope_or_policy_limit",
        "confirms_claim",
        "history_or_example",
        "none_applies",
        "not_applicable"
      ],
      "description": "Main reason for no_change: the first value in this order that applies; not_applicable for any other action."
    }
  }
}
